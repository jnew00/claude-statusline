  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Claude Code runs the one statusLine.command with session JSON",
        "Kickbacks adapter prints its ad, then runs the PREV target",
        "Wrapper execs the HUD, which draws the two boxes to stdout"
      ]
    },
    {
      "dot": "amber",
      "title": "Chain traps",
      "items": [
        "settings.json must point at the substituted ~/.vibe-ads adapter, not the .asset.mjs template",
        "PREV must name the wrapper, never the adapter (self-spawn guard)"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "OAuth token comes from the keychain, falls back to ~/.claude/.credentials.json, then cli-proxy files",
        "Third-party tools (Kickbacks, Codebacks) own their files; the HUD only reads"
      ]
    },
    {
      "dot": "slate",
      "title": "Not in this path",
      "items": [
        "src/claude-plan-usage.ts is a separate daemon writing ~/.claude/plan-usage.json",
        "docker/ holds a legacy Playwright scraper setup"
      ]
    }
  ]
